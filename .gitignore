
# this file lists files and folders that should be IGNORED
# from version control
# and not checked-in or uploaded to GitHub

# ignore secret env variable from the ".env" file:
.env

# ignore some hidden files that appear on Mac OS:
.DS_Store


# ignore some specific files that may get generated when running python modules or tests:
__pycache__
.pytest-cache


# ignore any CSV files written to the data directory:
data/*/*.csv
